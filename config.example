# Copy to config.toml and edit.

# Where your ADS-B decoder serves aircraft.json. Either the full URL, or just the
# host (e.g. "http://raspberrypi.local") and the common paths are probed:
#   /data/aircraft.json            readsb / adsb.im (often on :8080)
#   /tar1090/data/aircraft.json    tar1090
#   /dump1090-fa/data/aircraft.json  FlightAware dump1090-fa / PiAware
#   /skyaware/data/aircraft.json   PiAware SkyAware
adsb_url = "http://flightpi.local"

# Your location. If left out, it is read from the decoder's receiver.json.
# home_lat = 51.4700
# home_lon = -0.4543

radius_km = 20

# Include aircraft parked or taxiing (useful only if you live by an airport)
show_on_ground = false
refresh_seconds = 20

# Web server
host = "0.0.0.0"
port = 8035

# Model that cuts the aircraft out of its photo. "isnet-general-use" is the
# best (~180 MB); "u2netp" is tiny and quicker on an older Pi but rougher.
cutout_model = "isnet-general-use"

# How aircraft are drawn: "watercolour" (crisp pen and wash), "soft" (loose,
# wet watercolour) or "ink" (pen and ink)
style = "watercolour"

# Text size multiplier, e.g. 1.2 if the notes are hard to read on your TV.
# Photo credits stay small regardless.
text_scale = 1.0

# Altitude depth cue: high aircraft are drawn smaller and paler, as if seen
# through haze. 0.3 means up to 30% smaller at 40,000 ft; 0 turns it off,
# keeping sizes strictly to scale. Maximum 0.5.
altitude_depth = 0.3

# Name shown in the page heading
place_name = "Above the house"